{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/invoices/[id]/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/invoices/[id]/receipt/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 3 * * *"
    }
  ]
}
