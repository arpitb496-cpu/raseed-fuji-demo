# ========================================================
# Raseed - Environment Configuration Template
# All secrets MUST be provided via secure environment variables.
# NEVER commit real private keys or secrets to version control.
# ========================================================

# Network Selection: 'fuji' (default) or 'mainnet' (Required, Public)
NEXT_PUBLIC_NETWORK=fuji

# Application Base URL (Required in production, Public)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side App Base URL fallback (Optional if NEXT_PUBLIC_APP_URL is set, Non-public)
APP_BASE_URL=

# WalletConnect Cloud Project ID (Required in production from cloud.walletconnect.com, Public)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Session Secret: >=32 chars (Required in production; generate via openssl rand -base64 48, Secret)
SESSION_SECRET=

# Cron Reconciliation Secret for Bearer auth (Required in production; generate via openssl rand -base64 48, Secret)
CRON_SECRET=

# Database Connection URL (Required, Secret)
DATABASE_URL=postgresql://user:password@localhost:5432/raseed?schema=public

# Database Direct URL for migrations when using pooler (Optional, Secret)
DIRECT_URL=postgresql://user:password@localhost:5432/raseed?schema=public

# Test Database URL for isolated vitest runs (Optional, Secret)
TEST_DATABASE_URL=

# Upstash Redis REST URL for distributed rate limiting (Required in production, Secret)
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token for distributed rate limiting (Required in production, Secret)
UPSTASH_REDIS_REST_TOKEN=

# Avalanche Fuji Server-Only RPC Endpoint (Optional, Secret)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Avalanche Fuji Browser Public RPC Endpoint (Optional, Public)
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Avalanche Mainnet Server-Only RPC Endpoint (Optional, Secret)
MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Avalanche Mainnet Browser Public RPC Endpoint (Optional, Public)
NEXT_PUBLIC_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Fuji PaymentRouter Address (Optional - falls back to deployed Fuji router in deployments.json, Public)
NEXT_PUBLIC_FUJI_ROUTER_ADDRESS=

# Mainnet PaymentRouter Address (Optional - populate upon mainnet release, Public)
NEXT_PUBLIC_MAINNET_ROUTER_ADDRESS=

# Circle Native USDC Fuji Token Address (Optional, Public)
NEXT_PUBLIC_FUJI_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# Circle Native USDC Mainnet Token Address (Optional, Public)
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E

# Mainnet Activation Guard (Optional - strictly disabled by default, Non-public)
ALLOW_MAINNET=false

# Client-side Mainnet Activation Guard (Optional - strictly disabled by default, Public)
NEXT_PUBLIC_ALLOW_MAINNET=false

# Search Engine Indexing Guard - set true for demo noindex / nofollow (Optional, Non-public)
DEMO_INVITE_MODE=true

# Test-Only Login Endpoint Flag - must be absent/false in production (Optional, Non-public)
ENABLE_TEST_LOGIN=false

# Required on-chain block confirmations before settling invoices (Optional, default 3, Non-public)
CONFIRMATIONS=3

# Security Vulnerability Contact Email (Optional, Non-public)
SECURITY_CONTACT_EMAIL=

# Support Contact Email (Optional, Non-public)
SUPPORT_CONTACT_EMAIL=

# Sentry Error Reporting DSN (Server-only) (Optional, Secret)
SENTRY_DSN=

# Sentry Error Reporting DSN (Browser client) (Optional, Public)
NEXT_PUBLIC_SENTRY_DSN=

# In-Memory Unit Test DB Store - strictly forbidden in production (Optional, Non-public)
USE_MEMORY_STORE=false

# Node environment: 'development', 'test', or 'production' (Optional, Non-public)
NODE_ENV=development

# Playwright Custom Browser Binary Path on Linux hosts (Optional, Non-public)
PLAYWRIGHT_BROWSERS_PATH=

# CI environment flag - auto-set by CI runners (Optional, Non-public)
CI=false

# Platform auto-detected runtime variables (DO NOT SET MANUALLY):
# VERCEL - set to '1' by Vercel platform environment (Non-public)
# AWS_LAMBDA_FUNCTION_NAME - set automatically by AWS Lambda runtime (Non-public)
# NEXT_RUNTIME - set automatically by Next.js to 'nodejs' or 'edge' (Non-public)
