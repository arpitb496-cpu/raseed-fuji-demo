# ========================================================
# Raseed Protocol - Environment Configuration Template
# All secrets MUST be provided via secure environment variables.
# NEVER commit real private keys or secrets to version control.
# ========================================================

# Network Selection: 'fuji' (default) or 'mainnet'
NEXT_PUBLIC_NETWORK=fuji

# Avalanche Browser Public RPC Endpoints (Shipped to client bundle)
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Avalanche Server-Only RPC Endpoints (Optional; backend only - never exposed to browser)
# Used by settlement, verification, reconciliation, and payment report routes.
# Fallback: deployments.json public RPC or NEXT_PUBLIC_*_RPC_URL if unset.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Contract Addresses
# Fuji PaymentRouter (deploy and populate via /docs/DEPLOY_FUJI.md)
NEXT_PUBLIC_FUJI_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
# Mainnet PaymentRouter (populate upon mainnet go-live)
NEXT_PUBLIC_MAINNET_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# Verified Circle Native USDC Token Addresses (Source: developers.circle.com)
NEXT_PUBLIC_FUJI_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E

# Database (PostgreSQL - Neon or Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/raseed?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/raseed?schema=public

# Session Authentication (SIWE)
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_32_byte_base64_string

# Deployment & On-Chain Script Configuration (Use Foundry encrypted keystore: cast wallet import)
# No private keys in environment files. Pass --account <keystore_name> to forge script.
SNOWTRACE_API_KEY=your_snowtrace_api_key_for_contract_verification
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Mainnet Gating Flag (Must be explicitly true to deploy to mainnet)
CONFIRM_MAINNET_DEPLOY=false
OWNER_SAFE_ADDRESS=0x0000000000000000000000000000000000000000

# Rate Limiting (Upstash Redis) - Falls back to in-memory in dev
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Vercel Cron Secret (For Payment Reconciliation endpoint)
CRON_SECRET=replace_with_secure_random_cron_secret

# Demo / Search Engine Indexing Guard (Search-engine noindex only; NOT access control)
DEMO_INVITE_MODE=true

# Application Base URL (Required in production; used for PDF payment links and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Vulnerability Contact (Optional; if unset, displays 'contact details coming soon')
SECURITY_CONTACT_EMAIL=

# Optional Services (Off by default)
EMAIL_ENABLED=false
RESEND_API_KEY=re_your_resend_api_key
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

