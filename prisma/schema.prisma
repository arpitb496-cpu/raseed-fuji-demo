// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

model Merchant {
  id                     String      @id @default(cuid())
  walletAddress          String      @unique // Normalized lowercase
  displayName            String
  businessName           String?
  country                String?
  defaultCurrencyDisplay String      @default("USD")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  invoices               Invoice[]
  auditLogs              AuditLog[]
}

model Invoice {
  id                 String        @id @default(cuid())
  publicId           String        @unique // 24+ char unguessable identifier
  merchantId         String
  merchant           Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  invoiceNumber      String
  title              String
  notes              String?
  clientName         String?
  clientEmail        String?
  currencyDisplay    String        @default("USD")
  amountUsdc         BigInt        // Micro-USDC (integer, 6 decimals; CHECK >= 1,000,000)
  paidAmountUsdc     BigInt        @default(0) // Cumulative verified micro-USDC (CHECK >= 0)
  dueDate            DateTime
  status             InvoiceStatus @default(DRAFT)
  onchainInvoiceId   String        // Hex string of bytes32 derived from publicId
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items              InvoiceItem[]
  paymentEvents      PaymentEvent[]
  auditLogs          AuditLog[]

  @@index([merchantId])
  @@index([onchainInvoiceId])
  @@unique([merchantId, invoiceNumber])
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int      @default(1)
  unitAmountUsdc  BigInt   // Micro-USDC

  @@index([invoiceId])
}

model PaymentEvent {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  txHash           String
  logIndex         Int
  blockHash        String
  blockNumber      BigInt
  chainId          Int
  routerAddress    String   // Normalized lowercase
  merchantAddress  String   // Normalized lowercase
  payerAddress     String   // Normalized lowercase
  onchainInvoiceId String   // Canonical bytes32 hex
  amountUsdc       BigInt   // Micro-USDC transferred to merchant in this event
  feeUsdc          BigInt   @default(0) // Micro-USDC fee transferred to treasury
  confirmedAt      DateTime @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([invoiceId])
  @@index([payerAddress])
  @@index([merchantAddress])
  @@index([onchainInvoiceId])
}

model ReconciliationCursor {
  id              String   @id @default(cuid())
  chainId         Int
  routerAddress   String   // Normalized lowercase
  lastBlockNumber BigInt
  updatedAt       DateTime @updatedAt

  @@unique([chainId, routerAddress])
}

model AuditLog {
  id          String    @id @default(cuid())
  merchantId  String?
  merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  action      String
  details     String?
  createdAt   DateTime  @default(now())

  @@index([merchantId])
  @@index([invoiceId])
}
